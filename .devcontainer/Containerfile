FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# disable Ubuntu's built-in docker-clean scripts so the cache mounts actually persist
RUN rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-debs; \
    echo 'APT::Keep-Downloaded-Packages "true";' >> /etc/apt/apt.conf.d/keep-debs;

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        # core utils
        less \
        locales \
        git git-lfs \
        openssh-client \
        shellcheck shfmt \
        # podman in podman
        podman crun uidmap \
        catatonit \
        passt netavark aardvark-dns \
        # python
        python3-pip \
        python3-venv \
        python3-full \
        # libvirt
        libvirt-clients qemu-utils xorriso \
        # for pip to be able to build libvirt-python
        gcc pkg-config python3-dev libvirt-dev

RUN locale-gen en_US.UTF-8


### users

# rename ubuntu user/group/home to developer
RUN usermod -l developer ubuntu && \
    groupmod -n developer ubuntu && \
    usermod -d /home/developer -m developer
# RUN useradd -m -s /bin/bash developer

# (Optional) if sudo is installed and the user should get sudo-rights without password:
# RUN echo "developer ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/developer

# provision subordinate execution spaces
RUN echo "developer:100000:65536" > /etc/subuid && \
    echo "developer:100000:65536" > /etc/subgid


# create a host-matching libvirt group and add it to developer user
COPY libvirt.gid /tmp/libvirt.gid
RUN <<EOF
    gid="$(cat /tmp/libvirt.gid)"

    if [ "$gid" != "0" ]
    then
        getent group "$gid" >/dev/null || groupadd -g "$gid" libvirt
        usermod -aG "$(getent group "$gid" | cut -d: -f1)" developer
    fi
    rm /tmp/libvirt.gid
EOF

### install ansible

# bind Python environment to the user space
RUN python3 -m venv /opt/ansible-venv && \
    chown -R developer:developer /opt/ansible-venv
ENV PATH="/opt/ansible-venv/bin:$PATH"

USER developer
WORKDIR /home/developer

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir ansible-dev-tools molecule-plugins argcomplete libvirt-python lxml

# autocomplete for ansible/molecule
RUN <<EOF
echo '
eval "$(_MOLECULE_COMPLETE=bash_source molecule)"
eval "$(register-python-argcomplete ansible)"
eval "$(register-python-argcomplete ansible-playbook)"
eval "$(register-python-argcomplete ansible-galaxy)"
' >> ~/.bashrc
EOF

CMD ["/bin/bash"]
